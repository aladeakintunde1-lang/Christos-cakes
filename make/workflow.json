{
  "name": "Christos Cakes - Complete Order Management & Invoicing Automation (Make.com)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Christos Cakes Webhook Receiver"
        },
        "restore": {},
        "parameters": [],
        "expect": [
          { "name": "event", "type": "text", "label": "Event Identifier (order.created, order.status_updated, invoice.issued, etc.)" },
          { "name": "type", "type": "text", "label": "Event Type (NEW_ORDER, STATUS_UPDATED, INVOICE_ISSUED, etc.)" },
          { "name": "id", "type": "text", "label": "Order or Invoice ID" },
          { "name": "orderNumber", "type": "text", "label": "Unique Order Number (e.g. ORD-102934)" },
          { "name": "customerName", "type": "text", "label": "Customer Name" },
          { "name": "email", "type": "text", "label": "Customer Email" },
          { "name": "phone", "type": "text", "label": "Customer Phone" },
          { "name": "status", "type": "text", "label": "Order Status (New Order, Pending, Baking, Ready, Completed)" },
          { "name": "previousStatus", "type": "text", "label": "Previous Status (if updated)" },
          { "name": "totalPrice", "type": "number", "label": "Total Order Value (£)" },
          { "name": "deliveryFee", "type": "number", "label": "Delivery Fee (£)" },
          { "name": "fulfillmentType", "type": "text", "label": "Fulfillment Type (Collection/Delivery)" },
          { "name": "deliveryDate", "type": "text", "label": "Event or Delivery Date" },
          { "name": "deliveryTimeSlot", "type": "text", "label": "Time Window" },
          { "name": "category", "type": "text", "label": "Category (Cake, Pastries, Both)" },
          { "name": "flavor", "type": "text", "label": "Cake Flavor Palette" },
          { "name": "size", "type": "text", "label": "Cake Size / Tiers" },
          { "name": "numberOfTiers", "type": "number", "label": "Number of Tiers" },
          { "name": "messageOnCake", "type": "text", "label": "Cake Calligraphy / Message" },
          { "name": "pastriesSummary", "type": "text", "label": "Pastries Summary (Names & Quantities)" },
          { "name": "address", "type": "text", "label": "Delivery Street Address" },
          { "name": "postcode", "type": "text", "label": "Postcode" },
          { "name": "orderUrl", "type": "text", "label": "Live Client Order Tracking URL" },
          { "name": "appUrl", "type": "text", "label": "App Base URL" },
          { "name": "invoiceNumber", "type": "text", "label": "Unique Invoice Number (e.g. INV-2026-001)" },
          { "name": "invoiceUrl", "type": "text", "label": "Invoice PDF / Print View URL" },
          { "name": "dueDate", "type": "text", "label": "Invoice Due Date" },
          { "name": "feedbackRating", "type": "number", "label": "Feedback Rating (1-5)" },
          { "name": "feedbackComment", "type": "text", "label": "Feedback Comment" },
          { "name": "timestamp", "type": "text", "label": "ISO Timestamp" },
          { "name": "source", "type": "text", "label": "Source System" }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Router: Route Automation by Event"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "email:sendAnEmail",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "New Order Placed",
                "conditions": [
                  [
                    { "a": "{{1.event}}", "o": "text:equal", "b": "order.created" }
                  ],
                  [
                    { "a": "{{1.type}}", "o": "text:equal", "b": "NEW_ORDER" }
                  ]
                ]
              },
              "mapper": {
                "to": ["aladeakintunde1@gmail.com"],
                "subject": "🚨 ACTION REQUIRED: New Order #{{1.orderNumber}} Requires Processing",
                "content": "<h2>🚨 New Order Requires Processing</h2><p>A new customer commission has been placed and requires processing in the atelier.</p><hr/><h3>Customer Information</h3><ul><li><strong>Name:</strong> {{1.customerName}}</li><li><strong>Email:</strong> {{1.email}}</li><li><strong>Phone:</strong> {{1.phone}}</li><li><strong>Fulfillment:</strong> {{1.fulfillmentType}}</li><li><strong>Address / Postcode:</strong> {{1.address}} {{1.postcode}}</li></ul><h3>Commission Specifications</h3><ul><li><strong>Unique Order Number:</strong> {{1.orderNumber}}</li><li><strong>Status:</strong> New Order</li><li><strong>Event Date:</strong> {{1.deliveryDate}} ({{1.deliveryTimeSlot}})</li><li><strong>Category:</strong> {{1.category}}</li><li><strong>Cake Flavor:</strong> {{1.flavor}}</li><li><strong>Size & Tiers:</strong> {{1.size}} ({{1.numberOfTiers}} Tier)</li><li><strong>Calligraphy Message:</strong> {{1.messageOnCake}}</li><li><strong>Order Items / Pastries:</strong> {{1.pastriesSummary}}</li><li><strong>Total Value:</strong> £{{1.totalPrice}} (Delivery: £{{1.deliveryFee}})</li></ul><p><a href=\"{{1.appUrl}}/admin\" style=\"background:#be185d;color:#fff;padding:12px 24px;border-radius:8px;text-decoration:none;display:inline-block;\">Open Studio Admin & Process Order</a></p>"
              },
              "metadata": {
                "designer": { "x": 600, "y": -350, "name": "1A. Notify Business Owner (Requires Processing)" }
              }
            },
            {
              "id": 4,
              "module": "email:sendAnEmail",
              "version": 2,
              "parameters": {},
              "mapper": {
                "to": ["{{1.email}}"],
                "subject": "Christos Cakes: Order Confirmation #{{1.orderNumber}}",
                "content": "<h2>Order Confirmation: Your Commission Has Been Received</h2><p>Dear {{1.customerName}},</p><p>Thank you for choosing Christos Cakes Atelier. We have received your order and our artisan bakers are preparing your bespoke confectionery.</p><hr/><h3>Order Summary</h3><ul><li><strong>Order Number:</strong> {{1.orderNumber}}</li><li><strong>Status:</strong> {{1.status}}</li><li><strong>Scheduled Date:</strong> {{1.deliveryDate}} ({{1.deliveryTimeSlot}})</li><li><strong>Fulfillment Method:</strong> {{1.fulfillmentType}}</li><li><strong>Selection:</strong> {{1.category}} - {{1.flavor}} ({{1.size}})</li><li><strong>Order Items / Pastries:</strong> {{1.pastriesSummary}}</li><li><strong>Total Order Value:</strong> £{{1.totalPrice}}</li></ul><p><a href=\"{{1.orderUrl}}\" style=\"background:#be185d;color:#fff;padding:12px 24px;border-radius:8px;text-decoration:none;display:inline-block;\">View Live Order Status & Receipt</a></p><p>If you have questions, reply directly to this email or contact us via WhatsApp.</p>"
              },
              "metadata": {
                "designer": { "x": 900, "y": -350, "name": "1B. Notify Customer (Order Confirmation)" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "email:sendAnEmail",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "Order Status Updated",
                "conditions": [
                  [
                    { "a": "{{1.event}}", "o": "text:equal", "b": "order.status_updated" }
                  ],
                  [
                    { "a": "{{1.type}}", "o": "text:equal", "b": "STATUS_UPDATED" }
                  ]
                ]
              },
              "mapper": {
                "to": ["{{1.email}}"],
                "subject": "Christos Cakes: Order #{{1.orderNumber}} Status Updated to {{1.status}}",
                "content": "<h2>Order Status Progression</h2><p>Dear {{1.customerName}},</p><p>Your order status has transitioned from <em>{{1.previousStatus}}</em> to <strong>{{1.status}}</strong>.</p><p><strong>Event / Delivery Date:</strong> {{1.deliveryDate}} ({{1.deliveryTimeSlot}})</p><p><a href=\"{{1.orderUrl}}\">Click here to track your commission progress</a>.</p>"
              },
              "metadata": {
                "designer": { "x": 600, "y": -120, "name": "2. Customer Status Progression Alert" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "email:sendAnEmail",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "Invoice Issued",
                "conditions": [
                  [
                    { "a": "{{1.event}}", "o": "text:equal", "b": "invoice.issued" }
                  ],
                  [
                    { "a": "{{1.type}}", "o": "text:equal", "b": "INVOICE_ISSUED" }
                  ]
                ]
              },
              "mapper": {
                "to": ["{{1.email}}", "aladeakintunde1@gmail.com"],
                "subject": "Christos Cakes: Official Tax Invoice {{1.invoiceNumber}} for Order #{{1.orderNumber}}",
                "content": "<h2>Official Tax Invoice Issued</h2><p>Dear {{1.customerName}},</p><p>Your bespoke invoice <strong>{{1.invoiceNumber}}</strong> for Order #{{1.orderNumber}} has been generated.</p><ul><li><strong>Total Due:</strong> £{{1.totalPrice}}</li><li><strong>Due Date:</strong> {{1.dueDate}}</li><li><strong>Status:</strong> Issued</li></ul><p><a href=\"{{1.invoiceUrl}}\" style=\"background:#be185d;color:#fff;padding:12px 24px;border-radius:8px;text-decoration:none;display:inline-block;\">View & Download PDF Invoice</a></p><p>Bank transfer payment details and terms are included on your invoice document.</p>"
              },
              "metadata": {
                "designer": { "x": 600, "y": 80, "name": "3. Invoice Issued Notification (Client & Owner)" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "email:sendAnEmail",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "Bespoke Quote / Sent to Client",
                "conditions": [
                  [
                    { "a": "{{1.event}}", "o": "text:equal", "b": "order.sent_to_client" }
                  ],
                  [
                    { "a": "{{1.event}}", "o": "text:equal", "b": "order.quote_updated" }
                  ],
                  [
                    { "a": "{{1.type}}", "o": "text:equal", "b": "SEND_ORDER" }
                  ],
                  [
                    { "a": "{{1.type}}", "o": "text:equal", "b": "QUOTE_UPDATED" }
                  ]
                ]
              },
              "mapper": {
                "to": ["{{1.email}}"],
                "subject": "Christos Cakes: Bespoke Quotation for Order #{{1.orderNumber}}",
                "content": "<h2>Your Bespoke Quote is Ready</h2><p>Dear {{1.customerName}},</p><p>Our atelier has prepared your personalized quotation for your celebration on {{1.deliveryDate}}.</p><p><strong>Total Quoted: £{{1.totalPrice}}</strong> (Delivery: £{{1.deliveryFee}})</p><p><a href=\"{{1.orderUrl}}\">Review and confirm your bespoke quotation</a></p>"
              },
              "metadata": {
                "designer": { "x": 600, "y": 250, "name": "4. Quotation Dispatched to Client" }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 8,
              "module": "email:sendAnEmail",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "Customer Feedback Received",
                "conditions": [
                  [
                    { "a": "{{1.event}}", "o": "text:equal", "b": "feedback.submitted" }
                  ],
                  [
                    { "a": "{{1.type}}", "o": "text:equal", "b": "NEW_FEEDBACK" }
                  ]
                ]
              },
              "mapper": {
                "to": ["aladeakintunde1@gmail.com"],
                "subject": "Christos Cakes: New {{1.feedbackRating}}-Star Review for Order #{{1.orderNumber}}",
                "content": "<h2>Customer Feedback Received</h2><p><strong>Customer:</strong> {{1.customerName}} ({{1.email}})</p><p><strong>Order Number:</strong> {{1.orderNumber}}</p><p><strong>Rating:</strong> {{1.feedbackRating}} / 5 Stars</p><p><strong>Review:</strong></p><blockquote>{{1.feedbackComment}}</blockquote>"
              },
              "metadata": {
                "designer": { "x": 600, "y": 420, "name": "5. Customer Feedback Alert to Owner" }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 9,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {
        "status": 200
      },
      "mapper": {
        "body": "{\"success\": true, \"synchronized\": true, \"event\": \"{{1.event}}\", \"orderNumber\": \"{{1.orderNumber}}\", \"source\": \"Make.com Automation\"}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Webhook Response Acknowledge"
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true
    },
    "designer": {
      "orphans": []
    }
  }
}
